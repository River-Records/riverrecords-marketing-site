---
import Page from '../../layouts/Page.astro';
import { competitors, bySlug, PRICING_VERIFIED } from '../../config/competitors';
import { pricing } from '../../config/pricing';

export async function getStaticPaths() {
  // `freedai` has its own bespoke page and is deliberately not generated here.
  return competitors.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const onboardUrl = `https://stream.riverrecords.ai/onboard/stream-pro?utm_source=comparison&utm_medium=landing&utm_campaign=vs-${c.slug}`;
---
<Page title={c.seoTitle} description={c.seoDescription}>

<Fragment slot="head">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": c.title,
    "description": c.seoDescription,
    "publisher": { "@type": "Organization", "name": "River Records" },
  })} />
</Fragment>

<style>
.vs { padding: 60px 0 88px; }
.vs-wrap { max-width: 780px; margin: 0 auto; }
.vs h1 { font-size: clamp(2rem, 4.2vw, 2.9rem); color: var(--ink); line-height: 1.15; margin-bottom: 16px; }
.vs-lede { font-size: 1.1rem; color: var(--ink-muted); line-height: 1.7; margin-bottom: 12px; }
.vs-stamp { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 36px; padding-bottom: 22px; border-bottom: 1px solid var(--border); }

.vs h2 { font-size: 1.5rem; color: var(--ink); margin: 44px 0 14px; line-height: 1.3; }
.vs p { font-size: 1rem; color: var(--ink-muted); line-height: 1.75; margin-bottom: 16px; }
.vs ul { margin: 0 0 18px; padding-left: 22px; }
.vs li { font-size: 1rem; color: var(--ink-muted); line-height: 1.75; margin-bottom: 10px; }

table.vs-table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.92rem; }
table.vs-table th { text-align: left; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); padding: 0 14px 10px 0; border-bottom: 1px solid var(--border-strong); font-weight: 500; }
table.vs-table td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--border); color: var(--ink-muted); line-height: 1.6; vertical-align: top; }
table.vs-table td:first-child { color: var(--ink); font-weight: 600; white-space: nowrap; }

.vs-honest { background: var(--surface-warm); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 24px 28px; margin: 28px 0; }
.vs-honest h2 { margin-top: 0; font-size: 1.25rem; }
.vs-honest ul { margin-bottom: 0; }

.vs-question { border-left: 3px solid var(--accent); padding: 6px 0 6px 22px; margin: 32px 0; }
.vs-question p { font-family: var(--font-serif); font-size: 1.3rem; color: var(--ink); line-height: 1.45; margin: 0; font-style: italic; }

.vs-pick { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 28px 0; }
.vs-pick-card { border: 1px solid var(--border); border-radius: var(--r-lg); padding: 22px 24px; background: var(--white); }
.vs-pick-card h3 { font-size: 1rem; margin-bottom: 10px; color: var(--ink); font-family: var(--font-sans); }
.vs-pick-card p { font-size: 0.92rem; margin-bottom: 0; }
.vs-pick-them { background: var(--surface); }

.vs-price-note { font-size: 0.84rem; color: var(--ink-faint); line-height: 1.7; border-top: 1px solid var(--border); margin-top: 40px; padding-top: 20px; }
.vs-price-note a { color: var(--primary); }

.vs-cta { background: var(--dark); color: var(--white); border-radius: var(--r-xl); padding: 32px; margin-top: 40px; text-align: center; }
.vs-cta h2 { color: var(--white); margin: 0 0 10px; font-size: 1.5rem; }
.vs-cta p { color: rgba(250,247,240,0.78); margin-bottom: 22px; }
.vs-cta .btn { margin: 0 6px 8px; }

@media (max-width: 720px) { .vs-pick { grid-template-columns: 1fr; } }
</style>

<section class="vs">
  <div class="container">
    <div class="vs-wrap">

      <span class="section-label">Comparison</span>
      <h1>{c.title}</h1>
      <p class="vs-lede">{c.lede}</p>
      <p class="vs-stamp">Competitor pricing verified {PRICING_VERIFIED} · check theirs before deciding</p>

      <h2>At a glance</h2>
      <table class="vs-table">
        <tr><th></th><th>{c.name}</th><th>Stream</th></tr>
        <tr>
          <td>Price</td>
          <td>{c.pricing.them}</td>
          <td>{pricing.introPrice}, or {pricing.annualPrice} billed annually</td>
        </tr>
        <tr>
          <td>Free tier</td>
          <td>{c.pricing.freeTier}</td>
          <td>No — 30-day trial, no card</td>
        </tr>
        <tr>
          <td>EHR</td>
          <td>{c.pricing.ehr}</td>
          <td>Works alongside any EHR — copy and paste, no integration</td>
        </tr>
        <tr>
          <td>What it is</td>
          <td>A scribe</td>
          <td>A problem-based chart with a scribe in front of it</td>
        </tr>
      </table>

      <!-- The concession comes first, on purpose. A comparison that cannot name
           anything the other product does better reads as marketing. -->
      <div class="vs-honest">
        <h2>Where {c.name} is better</h2>
        <ul>
          {c.betterAtIt.map((x) => <li>{x}</li>)}
        </ul>
      </div>

      <h2>Where Stream is different</h2>
      <p>Not better at being a scribe — different in what it is for. Every product here writes a good note. The question is what happens to it afterwards.</p>
      <ul>
        {c.whereStreamDiffers.map((x) => <li>{x}</li>)}
      </ul>

      <div class="vs-question">
        <p>“{c.question}”</p>
      </div>

      <h2>Which one you should actually pick</h2>
      <div class="vs-pick">
        <div class="vs-pick-card vs-pick-them">
          <h3>Choose {c.name} if…</h3>
          <p>{c.chooseThemIf}</p>
        </div>
        <div class="vs-pick-card">
          <h3>Choose Stream if…</h3>
          <p>{c.chooseStreamIf}</p>
        </div>
      </div>

      <p class="vs-price-note">
        {c.pricing.themNote ? c.pricing.themNote + ' ' : ''}
        Pricing for {c.name} was taken from their public pricing page on {PRICING_VERIFIED} and may since have changed —
        <a href={c.pricing.source} rel="nofollow noopener" target="_blank">check it yourself</a> before deciding.
        Stream does not offer EHR write-back and is not SOC 2 certified; if either is a requirement for you, that is a
        reason to look elsewhere and we would rather say so here than on a call.
      </p>

      <div class="vs-cta">
        <h2>See whether the chart is the part worth solving</h2>
        <p>Thirty days, no card. Or twenty minutes with a physician who uses it daily.</p>
        <a href={onboardUrl} class="btn btn-primary-lg" data-vs-cta="trial">Start free trial</a>
        <a href="/book-demo" class="btn btn-secondary-lg" data-vs-cta="demo">Book a demo</a>
      </div>

    </div>
  </div>
</section>

</Page>
