          {INTAKE_EXCERPTS[0].groups.map((group) => (
            <div class="mock-group">
              <div class="mock-group-label">{group.label}</div>
              {group.facts.map((fact) => (
                <div class="mock-fact">
                  <span>{fact.text}</span>
                  <span class="mock-page">p.{fact.page}</span>
                </div>
              ))}
            </div>
          ))}
          <div class="mock-chiprow">
            <span class="mock-chip">Accept</span>
            <span class="mock-chip">No action</span>
            <span class="mock-chip">Re-tag</span>
            <span class="mock-chip">Dismiss</span>
            <span class="mock-chip mock-chip-on">View source</span>
            <span class="mock-chip">Include in note</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S6b — TWO WORDS -->
<section class="s-twowords ir">
  <div class="ic">
    <div class="twowords-box">
      <h3>Two words we chose carefully</h3>
      <p><strong>No action</strong> is not <em>discard</em>. Nothing is deleted; the excerpt stays visible on the document.</p>
      <p><strong>Dismiss</strong> takes it off <em>my</em> Huddle. It stays on the shared chart timeline — because the timeline is the record, and one clinician’s triage isn’t a chart decision.</p>
      <p>A personal view choice and a shared clinical decision are different things, and the interface never lets them blur.</p>
    </div>
  </div>
</section>

<!-- S7 — MEDICATIONS -->
