<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var dl = (window.dataLayer = window.dataLayer || []);

    // Reveal on scroll
    if (!reduce && 'IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.ir').forEach(function (el) { obs.observe(el); });
    } else {
      document.querySelectorAll('.ir').forEach(function (el) { el.classList.add('visible'); });
    }

    // Sticky CTA — on once the reader is past S2
    var sticky = document.getElementById('intake-sticky');
    var s2 = document.getElementById('s2');

    // Park it directly under the nav, whatever height the nav actually is.
    var nav = document.querySelector('.nav');
    var setNavHeight = function () {
      if (!nav) return;
      document.documentElement.style.setProperty('--intake-nav-h', nav.getBoundingClientRect().height + 'px');
    };
    setNavHeight();
    window.addEventListener('resize', setNavHeight);
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(setNavHeight); }
    if (sticky && s2 && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          sticky.classList.toggle('on', !e.isIntersecting && e.boundingClientRect.top < 0);
        });
      }, { threshold: 0 }).observe(s2);
    }

    // CTA clicks
    document.querySelectorAll('[data-intake-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        dl.push({ event: 'intake_cta_click', intake_cta: el.getAttribute('data-intake-cta') });
      });
    });

    // FAQ expands — tells us what the page failed to answer
    document.querySelectorAll('.faq-item').forEach(function (item) {
      item.addEventListener('toggle', function () {
        if (item.open) {
          dl.push({ event: 'intake_faq_expand', intake_faq: item.getAttribute('data-faq') });
        }
      });
    });

    // Scroll depth at S4 / S9 / S13
    ['s4', 's9', 's13'].forEach(function (id) {
      var el = document.getElementById(id);
      if (!el || !('IntersectionObserver' in window)) return;
      var seen = false;
      var o = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && !seen) {
            seen = true;
            dl.push({ event: 'intake_scroll_depth', intake_section: id });
            o.disconnect();
          }
        });
      }, { threshold: 0.25 });
      o.observe(el);
    });

    // S4 video path — pause control + reduced-motion default
    var video = document.getElementById('provenance-video');
    var pause = document.getElementById('provenance-pause');
    if (video) {
      if (reduce) { video.autoplay = false; video.removeAttribute('autoplay'); video.pause(); }
      var played = false;
      video.addEventListener('play', function () {
        if (played) return;
        played = true;
        dl.push({ event: 'intake_video_play' });
      });
      video.addEventListener('ended', function () { dl.push({ event: 'intake_video_complete' }); });
      if (pause) {
        var sync = function () {
          var paused = video.paused;
          pause.textContent = paused ? 'Play' : 'Pause';
          pause.setAttribute('aria-pressed', paused ? 'true' : 'false');
        };
        pause.addEventListener('click', function () {
          if (video.paused) { video.play(); } else { video.pause(); }
          sync();
        });
        sync();
      }
    }
  })();
</script>

