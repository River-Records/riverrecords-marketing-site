---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IntakeProvenanceDemo from '../components/demos/IntakeProvenanceDemo.vue';
import { INTAKE_MEDICATIONS, INTAKE_TASKS, INTAKE_EXCERPTS, INTAKE_DOCUMENT } from '../components/demos/demo-data.js';
import { inletPricing } from '../config/pricing';

// Product name — the copy deck's [PRODUCT NAME] placeholder resolves here.
// Changing this one line renames the product everywhere on the page.
const PRODUCT = 'Stream Inlet';

// Launch state. Pre-launch copy says it ships next week; flip LAUNCHED to true on
// launch day and every availability string below reverts to the deck's own wording.
// "Next week" is dated copy — it is wrong the moment it ships, so do not leave it.
const LAUNCHED = false;
const avail = LAUNCHED
  ? {
      eyebrow: 'Now on Stream Pro',
      trust: 'Available on Stream Pro',
      sticky: '· Available on Stream Pro',
      closing: 'is on Stream Pro today.',
      faqPlan: 'Stream Pro.',
      ctaTrust: 'Available on Stream Pro',
      navCta: { ctaLabel: 'Start free trial', ctaHref: 'https://stream.riverrecords.ai/onboard/stream-pro' },
    }
  : {
      eyebrow: 'Next week on Stream Pro',
      trust: 'Coming to Stream Pro',
      sticky: '· Coming to Stream Pro',
      closing: 'is coming to Stream Pro next week.',
      faqPlan: 'Stream Pro, as a metered add-on. It ships next week.',
      ctaTrust: 'Coming to Stream Pro',
      // Pre-launch the nav must not offer a trial of a product that isn't out.
      navCta: { ctaLabel: 'Book a demo', ctaHref: '/book-demo' },
    };

// S4 asset. The live demo component ships today; flip HAS_S4_VIDEO to true once a
// recording made from the demo components lands in public/intake/ and the <video>
// path takes over. Both paths honour prefers-reduced-motion.
const HAS_S4_VIDEO = false;
const S4_VIDEO = {
  webm: '/intake/provenance.webm',
  mp4: '/intake/provenance.mp4',
  poster: '/intake/provenance-poster.png',
};

const utm = '?utm_source=intake-page&utm_medium=landing&utm_campaign=intake-launch';
const demoUrl = `/book-demo${utm}`;

const faqs = [
  {
    q: 'Which fax carriers does Stream support?',
    a: 'Two options. Sinch is the River Records option — we provision the number, whitelist it and manage it for you, and it is what we recommend. Spruce Health is supported as an integration for practices already running Spruce: the number lives on your own Spruce account and your clinic manages it.',
  },
  {
    q: 'Do we have to give up our current fax number?',
    a: 'No. You get a Stream number and keep your existing line running as long as you want. There’s no cutover and no day where faxes could fall between two systems.',
  },
  {
    q: 'So how do senders find us?',
    a: 'We call them. A short list of senders — the hospital records department, the two or three specialty groups you refer to most, the imaging center — accounts for most of what arrives. We contact your highest-volume senders with your new number as part of setup, so the bulk of your inbound volume moves over without your front desk picking up the phone. The rest follows as you update your directory listings and referral forms.\n\nAnything that still comes to the old line, or arrives on paper, can be dragged into Stream from the Documents page and goes through exactly the same pipeline.',
  },
  {
    q: 'What happens when a hospital sends 40 pages covering three patients?',
    a: 'Stream detects that the file contains more than one document or more than one patient and holds it for a person to sort out, rather than guessing. A clinician can release the hold explicitly.',
  },
  {
    q: 'Does Stream update the chart automatically?',
    a: 'No, and that’s deliberate. Every excerpt, medication list, and proposed task waits for a human decision. Stream’s job is to put the right thing in front of the right person, ready to accept in one click.',
  },
  {
    q: 'Does it reconcile our medication list?',
    a: 'No. Stream shows the medications each document mentions, tells you it’s that one document’s view, and leaves reconciliation to you. A reconciled patient medication list is on the roadmap.',
  },
  {
    q: 'Can I upload documents that didn’t come by fax?',
    a: 'Yes. PDFs — up to 10 at a time, 15MB each — plus text files, or text pasted straight in, all from the Documents page.',
  },
  {
    q: 'What plan is this on?',
    a: avail.faqPlan,
  },
  {
    q: 'What does it cost?',
    a: 'Stream Inlet is metered on top of Stream Pro: $89/month for 500 pages, $199 for 1,500, or $349 for 3,000, plus a $299 setup fee. Extra pages are $0.14. Your fax number and unlimited users are included, and junk faxes are filtered and never billed.',
  },
];

const trustPoints = [
  { lead: 'Excerpts can’t leak into your note.', rest: ' Structurally prevented, enforced by the build.' },
  { lead: 'Every fact traces to a highlighted sentence on the page', rest: ' — not a citation number.' },
  { lead: 'Facts that can’t be grounded in the source are dropped', rest: ', not shown.' },
  { lead: 'Multi-patient fax batches are detected and held', rest: ', not silently split into the wrong charts.' },
  { lead: 'Nothing is auto-filed.', rest: ' Excerpts, medications, and tasks all wait for a human decision.' },
  { lead: 'Nothing labeled as loss loses anything.', rest: ' “No action” and “Dismiss” both preserve the data, and both tell you where it’s still visible.' },
  { lead: 'Outside content lands under the problem it’s about', rest: ', not in a documents folder.' },
  { lead: 'A carrier retry never creates a duplicate.', rest: '' },
  { lead: 'Each practice’s data is isolated in its own database', rest: ', and carrier credentials are write-only — never displayed again after entry.' },
];
---
<Base
  title={`${PRODUCT} — Faxes and records, filed under the problem they’re about`}
  description="Stream reads inbound faxes and uploads, files them to the right patient, and sorts their content under the problems it belongs to. Every fact links to its page."
  ogImage="/intake/og-intake.png">

  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}></script>
  </Fragment>

<style>
.intake-page { font-family: var(--font-sans); color: var(--ink); background: var(--white); }
.intake-page h1, .intake-page h2, .intake-page h3 { font-family: var(--font-serif); }
.ic { max-width: 1100px; margin: 0 auto; padding: 0 28px; }
.ic-narrow { max-width: 720px; margin: 0 auto; padding: 0 28px; }
.il {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 16px;
}

/* Buttons — matching the Huddle page's product-page button set */
.ib-primary { display: inline-flex; align-items: center; gap: 6px; background: var(--primary-dark); color: var(--white); padding: 13px 26px; border-radius: 100px; font-size: 0.95rem; font-weight: 600; text-decoration: none; transition: background 0.15s; }
.ib-primary:hover { background: var(--primary); }
.ib-secondary { display: inline-flex; align-items: center; gap: 6px; background: none; color: var(--ink-muted); padding: 13px 26px; border-radius: 100px; border: 1.5px solid var(--border-strong); font-size: 0.95rem; font-weight: 600; text-decoration: none; transition: border-color 0.15s, color 0.15s; }
.ib-secondary:hover { border-color: var(--primary); color: var(--primary); }
.ib-white { display: inline-flex; align-items: center; gap: 6px; background: var(--white); color: var(--dark); padding: 13px 26px; border-radius: 100px; font-size: 0.95rem; font-weight: 700; text-decoration: none; transition: background 0.15s; }
.ib-white:hover { background: var(--primary-light); }
.ib-outline-white { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.85); border: 1.5px solid rgba(255,255,255,0.35); padding: 13px 26px; border-radius: 100px; font-size: 0.95rem; font-weight: 600; text-decoration: none; transition: border-color 0.15s, color 0.15s; }
.ib-outline-white:hover { border-color: rgba(255,255,255,0.7); color: #fff; }

/* Reveal */
.ir { opacity: 0; transform: translateY(24px); transition: opacity 0.4s ease-out, transform 0.4s ease-out; }
.ir.visible { opacity: 1; transform: translateY(0); }

/* Sticky CTA — appears once the reader is past S2 */
.intake-sticky {
  position: fixed;
  /* Sits directly under the nav. The nav grows taller than 62px on narrow
     screens when the logo wraps, so the real height is measured at runtime. */
  top: var(--intake-nav-h, 62px);
  left: 0; right: 0;
  z-index: 150;
  background: var(--white);
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  transform: translateY(-110%);
  transition: transform 0.25s ease;
}
.intake-sticky.on { transform: translateY(0); }
.intake-sticky-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 10px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.intake-sticky-label { font-size: 0.85rem; font-weight: 600; color: var(--ink); }
.intake-sticky-label span { color: var(--ink-faint); font-weight: 500; }
.intake-sticky .ib-primary { padding: 9px 20px; font-size: 0.85rem; }

/* S1 — hero */
.s-hero { padding: 72px 0 56px; }
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--primary-light);
  color: var(--primary);
  border: 1px solid var(--primary-border);
  border-radius: 100px;
  padding: 5px 16px;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 24px;
}
.s-hero h1 {
  font-size: clamp(2.3rem, 5vw, 3.5rem);
  line-height: 1.12;
  letter-spacing: -0.025em;
  color: var(--ink);
  max-width: 15ch;
  margin-bottom: 22px;
}
.hero-sub { font-size: 1.12rem; line-height: 1.68; color: var(--ink-muted); max-width: 60ch; margin-bottom: 30px; }
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
.hero-trust { display: flex; gap: 8px; flex-wrap: wrap; font-size: 0.78rem; color: var(--ink-muted); align-items: center; }
.hero-trust-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--border-strong); }

/* S2 — the problem */
.s-problem { padding: 72px 0; background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.s-problem h2 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 28px; max-width: 22ch; }
.problem-measure { max-width: 65ch; }
.problem-beat { font-size: 1.08rem; line-height: 1.6; color: var(--ink); margin-bottom: 6px; font-weight: 500; }
.problem-beat-last { margin-bottom: 24px; font-weight: 400; color: var(--ink-muted); }
.problem-turn { font-size: 1.08rem; line-height: 1.6; color: var(--ink); font-weight: 600; margin-bottom: 24px; }
.problem-because { font-size: 1rem; line-height: 1.72; color: var(--ink-muted); }
.problem-because em { color: var(--ink); font-style: italic; }

/* S3 — the reframe */
.s-reframe { padding: 80px 0; }
.reframe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.s-reframe h2 { font-size: clamp(1.8rem, 3.4vw, 2.4rem); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 20px; }
.s-reframe p { font-size: 1rem; line-height: 1.72; color: var(--ink-muted); margin-bottom: 18px; }
.s-reframe p strong { color: var(--ink); font-weight: 600; }
.reframe-figure { margin: 0; }
.reframe-figure svg { width: 100%; height: auto; display: block; }

/* Pull quotes — S3b, S7b */
.s-pull { padding: 72px 0; background: var(--surface-warm); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.s-pull blockquote {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 3.6vw, 2.5rem);
  line-height: 1.3;
  letter-spacing: -0.02em;
  color: var(--ink);
  max-width: 22ch;
  margin: 0 auto;
  text-align: center;
}

/* S4 — provenance */
.s-provenance { padding: 84px 0; }
.provenance-head { max-width: 66ch; margin-bottom: 40px; }
.s-provenance h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 20px; }
.s-provenance p { font-size: 1.02rem; line-height: 1.72; color: var(--ink-muted); margin-bottom: 16px; }
.provenance-kicker { font-size: 1.12rem !important; font-weight: 600; color: var(--ink) !important; margin-bottom: 0 !important; }
.provenance-stage { max-width: 940px; margin: 0 auto; }
.provenance-frame {
  position: relative;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 8px;
  box-shadow: 0 8px 24px rgba(15,26,20,0.10), 0 24px 60px rgba(15,26,20,0.08);
}
.provenance-video { width: 100%; height: auto; display: block; border-radius: 10px; }
.provenance-controls { display: flex; justify-content: flex-end; padding: 8px 4px 2px; }
.provenance-pause {
  font: inherit;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--ink-muted);
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: 100px;
  padding: 5px 14px;
  cursor: pointer;
}
.provenance-pause:hover { color: var(--primary); border-color: var(--primary); }

/* S5 — how it works */
.s-how { padding: 84px 0; background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.s-how h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 44px; max-width: 20ch; }
.how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.how-step {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 26px 24px;
}
.how-step-num {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--primary);
  margin-bottom: 10px;
}
.how-step h3 { font-size: 1.12rem; line-height: 1.32; color: var(--ink); margin-bottom: 10px; letter-spacing: -0.01em; }
.how-step p { font-size: 0.9rem; line-height: 1.66; color: var(--ink-muted); margin-bottom: 12px; }
.how-step p:last-child { margin-bottom: 0; }
/* Step 4 — the safety story gets its own weight */
.how-step-safety { border: 1.5px solid var(--accent-border); background: #fdf6f4; box-shadow: var(--shadow-sm); }
.how-step-safety .how-step-num { color: var(--accent-dark); }
.how-step-safety strong { color: var(--accent-dark); font-weight: 700; }
.how-hold {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.8rem;
  line-height: 1.5;
  color: var(--accent-dark);
  background: var(--white);
  border: 1px solid var(--accent-border);
  border-radius: 8px;
  padding: 9px 11px;
  margin-top: 12px;
}
.how-hold-tag {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  background: var(--accent);
  color: var(--white);
  border-radius: 4px;
  padding: 2px 6px;
  flex-shrink: 0;
  margin-top: 1px;
}

/* Worklist mock — S5 step 5 */
.worklist {
  margin-top: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  font-size: 0.78rem;
}
.worklist-head {
  background: var(--surface);
  padding: 6px 10px;
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-faint);
  border-bottom: 1px solid var(--border);
}
.worklist-row { padding: 9px 10px; border-bottom: 1px solid var(--border); }
.worklist-row:last-child { border-bottom: none; }
.worklist-doc { font-weight: 600; color: var(--ink); margin-bottom: 3px; }
.worklist-match { color: var(--ink-muted); }
.worklist-match strong { color: var(--primary); font-weight: 600; }
.worklist-state {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-faint);
  background: var(--surface);
  border-radius: 4px;
  padding: 2px 6px;
  margin-top: 5px;
}

/* Output sections — S6, S7, S8 */
.s-output { padding: 84px 0; }
.s-output-alt { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.output-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: start; }
.s-output h2 { font-size: clamp(1.75rem, 3.3vw, 2.35rem); line-height: 1.22; letter-spacing: -0.02em; margin-bottom: 22px; }
.s-output p { font-size: 1rem; line-height: 1.72; color: var(--ink-muted); margin-bottom: 18px; }
.s-output p strong { color: var(--ink); font-weight: 600; }
.s-output p em { font-style: italic; }
.output-actions {
  font-size: 0.92rem;
  line-height: 1.7;
  color: var(--ink);
  background: var(--white);
  border: 1px solid var(--border);
  border-left: 3px solid var(--primary);
  border-radius: 0 8px 8px 0;
  padding: 14px 16px;
}
.output-actions strong { font-weight: 600; }

/* Mock panels */
.mock {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: var(--shadow-md);
  overflow: hidden;
  font-size: 0.82rem;
}
.mock-marker {
  background: var(--surface-warm);
  text-align: center;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-faint);
  padding: 4px;
  border-bottom: 1px solid var(--border);
}
.mock-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
}
.mock-title { font-family: var(--font-mono); font-size: 0.64rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
.mock-meta { font-size: 0.7rem; color: var(--ink-faint); text-align: right; }
.mock-body { padding: 14px; }
.mock-stamp {
  font-size: 0.72rem;
  font-style: italic;
  color: var(--ink-faint);
  background: var(--surface);
  border-left: 2px solid var(--border-strong);
  border-radius: 0 4px 4px 0;
  padding: 7px 10px;
  margin-bottom: 12px;
  line-height: 1.5;
}
.mock-problem {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4px;
  flex-wrap: wrap;
}
.mock-icd {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 600;
  color: var(--ink-faint);
  background: var(--surface);
  border-radius: 4px;
  padding: 2px 6px;
}
.mock-merge { font-size: 0.72rem; color: var(--ink-faint); margin-bottom: 12px; }
.mock-group { margin-bottom: 11px; }
.mock-group-label {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 4px;
}
.mock-fact {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 7px 9px;
  margin-bottom: 4px;
  color: var(--ink);
  line-height: 1.5;
}
.mock-page { font-size: 0.66rem; font-weight: 600; color: var(--primary); flex-shrink: 0; }
.mock-chiprow { display: flex; flex-wrap: wrap; gap: 4px; border-top: 1px solid var(--border); padding-top: 11px; margin-top: 12px; }
.mock-chip { font-size: 0.66rem; color: var(--ink-faint); border: 1px solid var(--border); border-radius: 4px; padding: 3px 7px; }
.mock-chip-on { color: var(--primary); border-color: var(--primary-border); background: var(--primary-light); font-weight: 600; }

/* Medication mock */
.mock-med { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--border); padding: 9px 0; }
.mock-med:last-of-type { border-bottom: none; }
.mock-med-name { font-weight: 600; color: var(--ink); }
.mock-med-detail { font-size: 0.76rem; color: var(--ink-muted); }
.mock-med-change { font-size: 0.66rem; color: var(--ink-faint); font-family: var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; }
.mock-summary { font-size: 0.84rem; line-height: 1.65; color: var(--ink-muted); margin-bottom: 4px; }
.mock-note {
  font-size: 0.72rem;
  color: var(--ink-faint);
  line-height: 1.55;
  border-top: 1px solid var(--border);
  padding-top: 10px;
  margin-top: 4px;
}

/* Task mock */
.mock-task { border: 1px solid var(--border); border-radius: 8px; padding: 11px; margin-bottom: 8px; }
.mock-task-action { font-weight: 600; color: var(--ink); line-height: 1.4; margin-bottom: 5px; }
.mock-task-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px; }
.mock-task-tag { font-size: 0.62rem; font-weight: 600; color: var(--ink-faint); background: var(--surface); border-radius: 4px; padding: 2px 6px; }
.mock-quote {
  font-size: 0.73rem;
  line-height: 1.55;
  color: var(--ink-muted);
  font-style: italic;
  border-left: 2px solid var(--primary);
  padding: 2px 0 2px 9px;
  margin-bottom: 8px;
}
.mock-assignee { font-size: 0.7rem; color: var(--ink-faint); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.mock-assignee strong { color: var(--ink-muted); font-weight: 600; }

/* S6b — two words */
.s-twowords { padding: 0 0 84px; }
.twowords-box {
  max-width: 720px;
  margin: 0 auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 26px 28px;
}
