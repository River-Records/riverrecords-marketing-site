---
const {
  ctaLabel = 'Start free trial',
  ctaHref = 'https://stream.riverrecords.ai/onboard/stream-pro',
} = Astro.props;
---
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span class="nav-logo-main">Stream <span>·</span> River Records</span>
      <span class="nav-logo-sub">AI Clinical Documentation</span>
    </a>
    <ul class="nav-links">
      <li><a href="/#how-it-works">How It Works</a></li>
      <li class="nav-dropdown" id="product-dropdown">
        <span class="nav-dropdown-toggle">Product</span>
        <div class="nav-dropdown-menu">
          <a href="/#features">All Features</a>
          <a href="/features/huddle/">Huddle</a>
          <a href="/intake/">Stream Inlet</a>
        </div>
      </li>
      <li class="nav-dropdown" id="specialties-dropdown">
        <span class="nav-dropdown-toggle">Specialties</span>
        <div class="nav-dropdown-menu">
          <a href="/for/primary-care/">Primary Care</a>
          <a href="/for/dpc/">Direct Primary Care</a>
          <a href="/for/pediatrics/">Pediatrics</a>
          <a href="/for/snf/">SNF & Long-Term Care</a>
        </div>
      </li>
      <li><a href="/about/">About</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/#pricing">Pricing</a></li>
      <li><a href="/#faq">FAQ</a></li>
    </ul>
    <div class="nav-actions">
      <a href="https://stream.riverrecords.ai/login" class="nav-login">Log In</a>
      <a href={ctaHref} class="btn btn-primary nav-cta">{ctaLabel}</a>
    </div>
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="mobile-menu" id="mobileMenu">
  <a href="/#how-it-works" class="mobile-menu-link">How It Works</a>
  <div class="mobile-menu-label">Product</div>
  <a href="/#features" class="mobile-menu-link" style="padding-left:28px;">All Features</a>
  <a href="/features/huddle/" class="mobile-menu-link" style="padding-left:28px;">Huddle</a>
  <a href="/intake/" class="mobile-menu-link" style="padding-left:28px;">Stream Inlet</a>
  <div class="mobile-menu-label">Specialties</div>
  <a href="/for/primary-care/" class="mobile-menu-link" style="padding-left:28px;">Primary Care</a>
  <a href="/for/dpc/" class="mobile-menu-link" style="padding-left:28px;">Direct Primary Care</a>
  <a href="/for/pediatrics/" class="mobile-menu-link" style="padding-left:28px;">Pediatrics</a>
  <a href="/for/snf/" class="mobile-menu-link" style="padding-left:28px;">SNF & Long-Term Care</a>
  <a href="/about/" class="mobile-menu-link">About</a>
  <a href="/blog/" class="mobile-menu-link">Blog</a>
  <a href="/#pricing" class="mobile-menu-link">Pricing</a>
  <a href="/#faq" class="mobile-menu-link">FAQ</a>
  <a href="https://stream.riverrecords.ai/login" class="mobile-menu-link">Log In</a>
  <a href={ctaHref} class="mobile-menu-link highlight">{ctaLabel} →</a>
</div>

<style>
  @media (max-width: 1024px) {
    .nav-cta { padding: 8px 14px; font-size: 0.8rem; white-space: nowrap; }
  }
  .mobile-menu-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    padding: 12px 18px 4px;
  }
</style>

<script>
  // Hamburger toggle
  document.getElementById('nav-hamburger')?.addEventListener('click', () => {
    document.getElementById('mobileMenu')?.classList.toggle('open');
  });
  document.querySelectorAll('.mobile-menu-link').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('mobileMenu')?.classList.remove('open');
    });
  });

  // Nav dropdowns — Product and Specialties
  const dropdowns = Array.from(document.querySelectorAll('.nav-dropdown'));
  dropdowns.forEach((dd) => {
    dd.querySelector('.nav-dropdown-toggle')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = dd.classList.contains('open');
      dropdowns.forEach((other) => other.classList.remove('open'));
      dd.classList.toggle('open', !wasOpen);
    });
  });
  document.addEventListener('click', () => {
    dropdowns.forEach((dd) => dd.classList.remove('open'));
  });

  // Active nav state
  const path = window.location.pathname;
  document.querySelectorAll('.nav-links a').forEach(link => {
    if (link.getAttribute('href') === path) {
      link.classList.add('active');
    }
  });
  // Highlight dropdown toggle if on a specialty page
  if (path.startsWith('/for/')) {
    document.getElementById('specialties-dropdown')?.querySelector('.nav-dropdown-toggle')?.classList.add('active');
  }
  // Highlight Product if on a product page
  if (path.startsWith('/features') || path.startsWith('/intake')) {
    document.getElementById('product-dropdown')?.querySelector('.nav-dropdown-toggle')?.classList.add('active');
  }
</script>
